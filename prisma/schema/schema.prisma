// Prisma schema – MySQL
// https://pris.ly/d/mysql

generator client {
  provider = "prisma-client-js"
  output = "../generated"
}

datasource db {
  provider = "mysql"
}

enum Permissao {
  DEV
  ADM
  TEC
  SUP
  PAT
  USR
}

model Coordenadoria {
  id           String    @id @default(uuid())
  nome         String    @db.VarChar(120)
  ativo        Boolean   @default(true)

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @default(now()) @updatedAt

  usuarios Usuario[]
  reservas Reserva[]
  solicitacoesAcesso HdSolicitacaoAcesso[]

  @@map("principal.coordenadorias")
}

model Usuario {
  id              String    @id @default(uuid())
  nome            String
  nomeSocial      String?
  login           String    @unique
  email           String    @unique
  permissao       Permissao @default(USR)
  status          Boolean   @default(true)
  avatar          String?   @db.Text
  coordenadoriaId String?

  telefone      String?   @db.VarChar(30)
  ultimoLogin   DateTime  @default(now())
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @default(now()) @updatedAt

  coordenadoria Coordenadoria?   @relation(fields: [coordenadoriaId], references: [id], onDelete: SetNull)
  reservas      Reserva[]
  participacoes ReservaParticipante[]
  avaliacoes    Avaliacao[] @relation("avaliador")

  hdSolicitanteChamados HdChamado[]          @relation("hdSolicitanteChamados")
  hdAbertoEmNomeDe      HdChamado[]          @relation("hdAbertoEmNomeDe")
  hdChamadoUsuarios     HdChamadoUsuario[]   @relation("hdChamadoUsuarios")
  hdAutorEventos        HdChamadoEvento[]    @relation("hdAutorEventos")
  hdAutorMensagens      HdMensagem[]         @relation("hdAutorMensagens")
  hdAutorAnexos         HdAnexo[]            @relation("hdAutorAnexos")
  hdAutorEncaminhamentos HdChamadoEncaminhamento[] @relation("hdAutorEncaminhamentos")
  hdServidorItens       HdItemPatrimonio[]   @relation("hdServidorItens")
  hdTransferencias      HdTransferenciaCabecalho[] @relation("hdUsuarioTransferencias")
  hdBaixasPatrimonio    HdBaixaPatrimonio[]        @relation("hdUsuarioBaixas")
  hdStatusPatrimonio    HdItemPatrimonioStatusHistorico[] @relation("hdUsuarioStatusPatrimonio")
  hdPontoFocalUnidades  HdPontoFocalUnidade[]             @relation("hdPontoFocalUnidades")
  hdBeneficiarioAcesso  HdSolicitacaoAcesso[]             @relation("hdBeneficiarioAcesso")
  hdNegadorAcesso       HdSolicitacaoAcesso[]             @relation("hdNegadorAcesso")

  @@map("principal.usuarios")
}